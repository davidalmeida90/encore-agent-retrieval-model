.vscode/
.idea/
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Local debug artifacts. dev_token.txt held a real (expired) Supabase JWT
# carrying the project ref, a user id and an email, and was one commit away
# from being published.
dev_token.txt
*token*.txt
.session

