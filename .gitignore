# Corpus artifacts. 147 MB of SEC HTML and extracted markdown, all of it
# reproducible with `python corpus/download.py`, so it is never checked in.
/corpus/downloads/*
!/corpus/downloads/.gitkeep
/corpus/markdown/*
!/corpus/markdown/.gitkeep
*.parquet

