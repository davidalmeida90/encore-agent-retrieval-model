# Copy to .env and fill in. Only the four values in the first two blocks are
# required; everything below has a working default in app/config.py, and the
# defaults there carry the measurement that set them.

# --- Supabase (auth + Postgres) ---
# Dashboard -> Project Settings -> API

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# Dashboard -> Project Settings -> Database -> Connection string.
# Use the DIRECT connection (host: db.<ref>.supabase.co), NOT the transaction
# pooler (pooler.supabase.com): migrations need a session-level connection.
# URL-encode special characters in the password.
DATABASE_URL=postgresql://postgres:your-password@db.your-project-ref.supabase.co:5432/postgres

# --- Model providers ---
# Two providers on purpose. Gemini generates (agent, keyword extraction,
# grounding judge) because its free tier allows 500 requests per model per day.
# OpenAI is used ONLY for embeddings, which Gemini's free tier does not cover.

GEMINI_API_KEY=your-gemini-api-key
OPENAI_API_KEY=sk-your-openai-api-key

# Three separate knobs, and they are separate deliberately: the model picker in
# the UI changes only the agent. Keyword extraction and the grounding judge stay
# on the cheap model whatever you select, because both run on every question.
GEMINI_CHAT_MODEL=gemini-3.1-flash-lite
GEMINI_KEYWORD_MODEL=gemini-3.1-flash-lite
GEMINI_GROUNDING_MODEL=gemini-3.1-flash-lite

OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536

# Hard stop on the agent loop, whatever provider is behind it.
AGENT_REQUEST_LIMIT=20

# --- SEC EDGAR ---
# Not a key. EDGAR is open, and asks only that you identify yourself in the
# User-Agent; without one it rate-limits hard. Put a real contact address here.
SEC_EDGAR_UA=YourName your.email@example.com

# --- Retrieval ---
# See app/config.py for why each of these is the number it is.

RETRIEVAL_CANDIDATE_K=50
RETRIEVAL_TOP_K=6
RETRIEVAL_RRF_K=60
RETRIEVAL_NEIGHBOR_RADIUS=0
RETRIEVAL_READ_NEIGHBOR_RADIUS=1
RETRIEVAL_FTS_CONFIG=english

# Cross-encoder rerank. "auto" uses the GPU when torch reports one and falls
# back to CPU; pin to "cpu" to keep the GPU free, or "cuda" to fail loudly
# instead of silently falling back.
RETRIEVAL_RERANK_ENABLED=true
RETRIEVAL_RERANK_POOL=30
RETRIEVAL_RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L6-v2
RETRIEVAL_RERANK_THREADS=8
RETRIEVAL_RERANK_DEVICE=auto

# --- Server ---
# Comma-separated browser origins allowed to call the API (CORS).
ALLOWED_ORIGINS=http://localhost:5173
