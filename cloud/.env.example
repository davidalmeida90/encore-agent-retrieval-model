# Copy to cloud/.env and fill in. Gitignored; never commit the real file.

# RunPod API key: https://console.runpod.io/user/settings
# Deploying a pod spends real money. Check `status` for the running cost and
# `down` to stop it.
RUNPOD_API_KEY=your-runpod-api-key

# Hugging Face token: https://huggingface.co/settings/tokens
# Read access is enough. Needed because the pod downloads the weights itself.
HF_TOKEN=your-hf-token
